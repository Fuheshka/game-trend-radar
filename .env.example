# Копия в .env на сервере (ecosystem.config.cjs читает .env автоматически; .env в git не попадает)
PORT=4200
# Слушать только localhost (за nginx). Без этого сервер доступен на всех интерфейсах.
HOST=127.0.0.1
# Автоскан каждые N минут (0 = выключен). Рекомендуется 30.
SCAN_INTERVAL_MIN=30
# Токен для POST /api/scan (кнопка «Запустить скан» спросит его один раз).
# Пусто: в dev скан открыт, в production (NODE_ENV=production) ручной скан отключён (403).
# Сгенерировать: openssl rand -hex 24
SCAN_TOKEN=
# Пауза между ручными сканами, мс
SCAN_COOLDOWN_MS=30000
# Лимит одновременных SSE-подключений к /api/events (сверх — 503)
SSE_MAX_CLIENTS=100
# Ограничить CORS своим доменом (по умолчанию *)
# CORS_ORIGIN=https://fuheshka.qd.je
# Telegram-алерты после каждого сохранённого снимка: новые арбитражные ниши, рост ×3 за неделю,
# деградация/восстановление источников. Оба пусты — алерты выключены.
# Токен — у @BotFather; chat id — из https://api.telegram.org/bot<токен>/getUpdates после /start боту.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
